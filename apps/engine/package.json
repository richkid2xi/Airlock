{
  "name": "@airlock/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --no-error-on-unmatched-pattern src",
    "test": "vitest run",
    "test:vitest": "vitest run --reporter=json --outputFile=../../.turbo/test-results/engine.json"
  },
  "dependencies": {
    "@airlock/golden": "workspace:*",
    "@airlock/policy-core": "workspace:*",
    "@airlock/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.39.0",
    "@coral-xyz/anchor": "^0.30.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@solana/web3.js": "^1.98.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@airlock/config": "workspace:*",
    "@eslint/js": "^9.20.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^20.17.19",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "tsup": "^8.3.6",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
